        "options": {}
      },
      "id": "2",
      "name": "Prepare Job Post",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        -960,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://host.docker.internal:11434/api/generate",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { model: 'llama3.2', stream: false, format: 'json', prompt: 'Classify this Facebook post. Return ONLY JSON: is_automation_job (boolean), confidence (0-1), job_summary, requirements, suggested_first_message. True only when the author is genuinely looking for automation/AI automation/n8n/workflow/CRM/lead/chatbot/AI-agent/integration services. Do not invent facts. Post: ' + $json.post_text } }}",
        "options": {}
      },
      "id": "3",
      "name": "Ollama - Qualify Post",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -720,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "const raw=$json.response||$json.body?.response||''; let r; try{r=JSON.parse(raw)}catch(e){const m=raw.match(/\\{[\\s\\S]*\\}/);if(!m)throw new Error('Ollama returned invalid JSON');r=JSON.parse(m[0])} return [{json:{...$('Prepare Job Post').first().json,...r}}];"
      },
      "id": "4",
      "name": "Parse Qualification",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -480,
        0
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "job",
              "leftValue": "={{ $json.is_automation_job }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "5",
      "name": "Is Automation Job?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        -240,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://host.docker.internal:11434/api/generate",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { model: 'llama3.2', stream: false, prompt: 'Write a concise professional personalized first sales message for this automation job post. Do not invent pricing, experience, results, or capabilities. Return only the message. Post: ' + $json.post_text + '\\nRequirements: ' + $json.requirements } }}",
        "options": {}
      },
      "id": "6",
      "name": "Ollama - Create First Message",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "const msg=$json.response||$json.body?.response||''; return [{json:{...$('Parse Qualification').first().json,first_message:msg,conversation_status:'awaiting_reply'}}];"
      },
