    {
      "parameters": {
        "jsCode": "const raw=$json.response||$json.body?.response||''; let r; try{r=JSON.parse(raw)}catch(e){const m=raw.match(/\\{[\\s\\S]*\\}/);if(!m)throw new Error('Ollama conversation response is invalid JSON');r=JSON.parse(m[0])} return [{json:{...$('Prepare Conversation').first().json,...r,ai_reply:r.reply}}];"
      },
