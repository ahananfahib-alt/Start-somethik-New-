        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { model: 'llama3.2', stream: false, format: 'json', prompt: 'You are an AI automation sales representative. Understand the prospect, answer naturally using only the provided conversation, and move an interested prospect toward a meeting. Never invent pricing, features, results, dates, names, or policies. Do NOT create Google Meet or Calendar events. When ready for a meeting, ask when they are available today or tomorrow and then stop. Return ONLY JSON: {\"stage\":\"continue|meeting_ready|waiting_for_availability\",\"reply\":\"customer-facing message\",\"reason\":\"short internal reason\"}. History: ' + $json.conversation_history + '\\nLatest message: ' + $json.prospect_message } }}",
        "options": {}
      },
